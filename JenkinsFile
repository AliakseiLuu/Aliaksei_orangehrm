pipeline {
    agent any

    tools {
        maven 'maven'
        allure 'allure'
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'master', description: 'Ветка для сборки')
        string(name: 'browser', defaultValue: 'chrome', description: 'Browser to use for tests')
        string(name: 'threadCount', defaultValue: '1', description: 'Number of parallel threads')
        string(name: 'config', defaultValue: 'all_tests', description: 'TestNG suite file (without .xml extension)')
        booleanParam(name: 'selenoidEnabled', defaultValue: true, description: 'Enable running on Selenoid')
    }

    environment {
        SELENOID_URL = 'http://host.docker.internal:4444/wd/hub'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                url: 'https://github.com/AliakseiLuu/Aliaksei_orangehrm.git',
                credentialsId: 'github-token'
            }
        }

        stage('Run tests') {
            steps {
                sh """
                   mvn -B clean test \
                    -Dbrowser=${params.browser} \
                    -DthreadCount=${params.threadCount} \
                    -Dconfig=${params.config} \
                    "-Dselenoid.enabled=${params.selenoidEnabled}" \
                """
            }
            post {
                always {
                    junit allowEmptyResults: true,
                        testResults: '**/target/surefire-reports/*.xml',
                        skipPublishingChecks: true

                    allure includeProperties: false,
                        jdk: '',
                        results: [[path: 'target/allure-results']]
                }
            }
        }
    }
}