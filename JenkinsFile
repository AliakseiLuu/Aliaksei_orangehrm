pipeline {
    agent any

    tools {
        maven 'maven'
        allure 'allure'
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'master', description: 'Branch name for build')
        choice(name: 'browser', choices: ['all', 'chrome', 'firefox'], description: 'Browser to use for tests')
        string(name: 'threadCount', defaultValue: '1', description: 'Number of parallel threads')
        string(name: 'config', defaultValue: 'all_tests', description: 'TestNG suite file (without .xml extension)')
        booleanParam(name: 'selenoidEnabled', defaultValue: true, description: 'Enable running on Selenoid')
    }

    environment {
        SELENOID_URL = 'http://host.docker.internal:4444/wd/hub'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                url: 'https://github.com/AliakseiLuu/Aliaksei_orangehrm.git',
                credentialsId: 'github-token'
            }
        }

        stage('Check Selenoid') {
            steps {
                script {
                    def status = sh(
                        returnStatus: true,
                        script: 'curl -s --connect-timeout 5 ${SELENOID_URL%/wd/hub}/status'
                    )
                    if (status != 0) {
                        error """
                            |Не удалось подключиться к Selenoid по адресу ${SELENOID_URL}
                            |Проверьте:
                            |  1. Запущен ли контейнер: docker ps --filter name=selenoid
                            |  2. Проброшен ли порт 4444: docker port selenoid
                            |  3. Доступен ли хаб изнутри Jenkins-контейнера:
                            |     docker exec jenkins curl -s http://host.docker.internal:4444/status
                            |     (для Linux контейнер Jenkins должен быть запущен с
                            |      --add-host=host.docker.internal:host-gateway)
                        """.stripMargin()
                    } else {
                        echo "Selenoid доступен: ${SELENOID_URL}"
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    //Очищаем данные один раз в самом начале
                     sh "mvn -B clean compile test-compile"

                    // Определяем список браузеров для запуска
                    def browsersToRun = []
                    if (params.browser == 'all') {
                        browsersToRun = ['chrome', 'firefox']
                    } else {
                        browsersToRun = [params.browser]
                    }

                    // Создаем карту для параллельного запуска
                    def parallelStages = [:]

                     browsersToRun.each { browserName ->
                        parallelStages["Browser-${browserName}"] = {
                            stage("Testing on ${browserName}") {
                                sh """
                                   mvn -B test \
                                    -Dbrowser=${browserName} \
                                    -DthreadCount=${params.threadCount} \
                                    -Dconfig=${params.config} \
                                    "-Dselenoid.enabled=${params.selenoidEnabled}"
                                """
                            }
                        }
                    }

                    // Запускаем созданные ветки параллельно
                    parallel parallelStages
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                        testResults: '**/target/surefire-reports/*.xml',
                        skipPublishingChecks: true

                    allure includeProperties: false,
                        jdk: '',
                        results: [[path: 'target/allure-results']]
                }
            }
        }
    }
}